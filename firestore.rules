rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares de controle de acesso baseado em papéis (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isAuthenticated() && request.auth.token.email.lower() == 'colletes@gmail.com';
    }

    function isCoordGeral() {
      return isAuthenticated() && request.auth.token.email.lower() == 'lorenammoraes@gmail.com';
    }

    function isViceCoordGeral() {
      return isAuthenticated() && request.auth.token.email.lower() == 'andresprojetos@gmail.com';
    }

    function isCoordOrAdmin() {
      return isMasterAdmin() || isCoordGeral() || isViceCoordGeral();
    }

    // Perfis de Usuários (Governança e Consentimento LGPD)
    match /usuarios/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isCoordOrAdmin());
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isMasterAdmin());
      allow delete: if isMasterAdmin();
    }

    // Dados Sensíveis de Catequizandos (LGPD — Criptografados e Restritos)
    match /catequizandos_seguros/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isCoordOrAdmin();
    }

    // Trilha Perene de Auditoria (Audit Trail — Art. 37 LGPD)
    // NUNCA alterável ou excluível por qualquer usuário para garantir integridade probatória
    match /audit_logs/{logId} {
      allow read: if isCoordOrAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Modelos de Notificações e Mensagens (WhatsApp e E-mail)
    match /notificacoes_templates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isCoordOrAdmin();
    }

    // Eventos, Retiros e Cronograma Pastoral
    match /eventos/{eventoId} {
      allow read: if isAuthenticated();
      allow write: if isCoordOrAdmin();
    }

    // Organogramas Oficiais
    match /organograma/{docId} {
      allow read: if isAuthenticated();
      allow write: if isCoordOrAdmin();
    }

    // Gestão de Usuários Autorizados e Solicitações Pendentes (RBAC & LGPD)
    match /authorized_users/{userEmail} {
      allow read: if isAuthenticated();
      allow write: if isCoordOrAdmin();
    }

    match /pending_users/{userEmail} {
      allow read: if isCoordOrAdmin() || (isAuthenticated() && request.auth.token.email.lower() == userEmail.lower());
      allow create: if isAuthenticated();
      allow update, delete: if isCoordOrAdmin();
    }

    // Lista de Chamadas e Frequência das Turmas (Sincronização em Nuvem)
    match /turma_chamadas/{turmaKey} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Dados das Turmas de Catequizandos (Sincronização em Nuvem)
    match /turma_alunos/{turmaKey} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Configurações Gerais e Cronograma de Eventos
    match /configuracoes/{docId} {
      allow read: if isAuthenticated();
      allow write: if isCoordOrAdmin();
    }

    // Cadastro Oficial e Fotos de Catequistas (LGPD — Acesso Restrito e Auditado)
    match /catequistas/{catId} {
      allow read: if isAuthenticated();
      allow write: if isCoordOrAdmin();
    }

    // Base de Conhecimento (Wiki da Catequese — Árvore de Pastas, Documentos e Materiais)
    match /knowledge_nodes/{nodeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isCoordOrAdmin();
    }

    // Listas de Tarefas (Kanban Boards)
    // Criação, edição e exclusão de quadros restritos à Coordenação Geral, Vice e Master Admin
    match /kanban_boards/{boardId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isCoordOrAdmin();
    }

    // Tickets das Listas de Tarefas
    // Apenas o criador do ticket ou Master Admin podem apagar. Usuários autorizados podem criar e editar.
    match /kanban_tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isMasterAdmin() || (isAuthenticated() && request.auth.token.email.lower() == resource.data.creatorEmail.lower());
    }

    // Notificações Pessoais de Tarefas e Chamados
    match /kanban_notifications/{notifId} {
      allow read, update, delete: if isAuthenticated() && (isMasterAdmin() || request.auth.token.email.lower() == resource.data.recipientEmail.lower());
      allow create: if isAuthenticated();
    }

    // ==============================================================
    // CHAT PASTORAL ASSÍNCRONO & PRESENÇA EM TEMPO REAL
    // ==============================================================
    // Presença e status online
    match /chat_presenca/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isCoordOrAdmin());
    }

    // Salas de Conversa (1-a-1 e Grupos)
    match /chat_salas/{salaId} {
      allow read: if isAuthenticated() && (
        isCoordOrAdmin() ||
        (resource.data.participantes != null && request.auth.uid in resource.data.participantes)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.participantes != null && request.auth.uid in request.resource.data.participantes
      );
      allow update: if isAuthenticated() && (
        isCoordOrAdmin() ||
        (resource.data.participantes != null && request.auth.uid in resource.data.participantes)
      );
      allow delete: if isAuthenticated() && (
        isCoordOrAdmin() ||
        resource.data.criadoPor == request.auth.uid
      );

      // Mensagens da Sala (com expurgo de 7 dias)
      match /mensagens/{msgId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.remetenteId;
        allow update: if isAuthenticated() && (
          isCoordOrAdmin() ||
          request.auth.uid == resource.data.remetenteId
        );
        allow delete: if isAuthenticated() && (
          isCoordOrAdmin() ||
          request.auth.uid == resource.data.remetenteId ||
          (get(/databases/$(database)/documents/chat_salas/$(salaId)).data.participantes != null &&
           request.auth.uid in get(/databases/$(database)/documents/chat_salas/$(salaId)).data.participantes)
        );
      }
    }

    // Listas de Contatos Personalizadas
    match /chat_listas/{listaId} {
      allow read, write: if isAuthenticated() && (
        isCoordOrAdmin() ||
        (resource == null && request.resource.data.ownerUid == request.auth.uid) ||
        (resource != null && resource.data.ownerUid == request.auth.uid)
      );
    }
  }
}
